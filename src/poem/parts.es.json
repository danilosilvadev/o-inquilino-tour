[
 {
  "id": "I-1",
  "canto": "Canto I",
  "mark": "*",
  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.2153,
    "seconds": 15.2,
    "lines": [
     "Hoy desperté extraño. Como si mi",
     "cuerpo fuera alquilado, y Yo un",
     "intruso. Un cuerpo extraño."
    ],
    "width": 40,
    "fadeIn": 0.1187,
    "burnOut": 0.3297,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.2153,
    "to": 0.3785,
    "seconds": 11.5,
    "lines": [
     "Mi corazón no era mío. Yo solo",
     "lo cargaba."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.3785,
    "to": 0.6492,
    "seconds": 19.1,
    "lines": [
     "Y cómo temblaba ante la lucidez. Ella",
     "fue mi horror mayor. Daría todo por no",
     "hospedarla. Pero aun así arañaba las",
     "paredes de mi cabeza."
    ],
    "width": 40,
    "fadeIn": 0.0944,
    "burnOut": 0.2622,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b4",
    "from": 0.6492,
    "to": 0.9574,
    "seconds": 21.7,
    "lines": [
     "La lucidez hizo de mi corazón un estorbo. Una",
     "bolsa de carne en la espalda. Y cuanto más la",
     "arrastraba, más pesado se hacía el rastro de",
     "tierra, de grava, de suelo."
    ],
    "width": 48,
    "fadeIn": 0.0829,
    "burnOut": 0.2303,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   }
  ],
  "stations": [
   5.0,
   0.35,
   -4.3,
   -8.95,
   -13.6
  ],
  "moves": {
   "double": 0.8,
   "pulse": 0.5,
   "erase": 0.4,
   "afterimage": 0.5
  },
  "seconds": 70.4
 },
 {
  "id": "I-2",
  "canto": "Canto I",
  "mark": "**",
  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.2457,
    "seconds": 14.0,
    "lines": [
     "Cuanto más pienso sobre lo que hace de",
     "mí, yo. Menos entiendo de esa",
     "sustancia."
    ],
    "width": 40,
    "fadeIn": 0.1287,
    "burnOut": 0.3576,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.2457,
    "to": 0.5282,
    "seconds": 16.1,
    "lines": [
     "Sé que siento más de lo que aguanto.",
     "Pero mi carne traza fronteras",
     "demasiado lejanas para alcanzarlas."
    ],
    "width": 40,
    "fadeIn": 0.112,
    "burnOut": 0.3111,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.5282,
    "to": 0.7452,
    "seconds": 12.3,
    "lines": [
     "Y me encierro dentro de fuera.",
     "No tengo casa. Soy un huésped."
    ],
    "width": 32,
    "fadeIn": 0.1458,
    "burnOut": 0.405,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b4",
    "from": 0.7452,
    "to": 0.9473,
    "seconds": 11.5,
    "lines": [
     "Un verdadero parásito."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   }
  ],
  "stations": [
   5.0,
   0.35,
   -4.3,
   -8.95,
   -13.6
  ],
  "moves": {
   "double": 1.0,
   "press": 0.6,
   "stretch": 0.3
  },
  "seconds": 56.9
 },
 {
  "id": "I-3",
  "canto": "Canto I",
  "mark": "***",
  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.2587,
    "seconds": 19.5,
    "lines": [
     "Me acuesto caliente, pero voy",
     "lentamente enfriándome. Y aun cuando",
     "el invierno acaba. Y el frío me deja.",
     "Yo sujeto su capa. Le prohíbo irse."
    ],
    "width": 40,
    "fadeIn": 0.0922,
    "burnOut": 0.2561,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.2587,
    "to": 0.4487,
    "seconds": 14.3,
    "lines": [
     "Esparzo por mi cuerpo sus agujas. Y en",
     "el escalofrío de cada pinchazo, me",
     "caliento."
    ],
    "width": 40,
    "fadeIn": 0.1255,
    "burnOut": 0.3485,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.4487,
    "to": 0.6556,
    "seconds": 15.6,
    "lines": [
     "Hago que el hielo cubra el sol. Hasta",
     "que la luz se enfríe. Quedando apenas",
     "una carne conservada."
    ],
    "width": 40,
    "fadeIn": 0.1153,
    "burnOut": 0.3201,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b4",
    "from": 0.6556,
    "to": 0.8079,
    "seconds": 11.5,
    "lines": [
     "Pero él no me obedece. Se",
     "escapa entre mis dedos."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b5",
    "from": 0.8079,
    "to": 0.9603,
    "seconds": 11.5,
    "lines": [
     "Me rechaza."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   }
  ],
  "stations": [
   5.0,
   0.8,
   -3.4,
   -7.6,
   -11.8,
   -16.0
  ],
  "moves": {
   "cold": 1.0,
   "swarm": 0.7,
   "erase": 0.3
  },
  "seconds": 75.5
 },
 {
  "id": "I-4",
  "canto": "Canto I",
  "mark": "****",
  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.3422,
    "seconds": 14.3,
    "lines": [
     "Y dentro de esta carne existe tierra.",
     "Donde comen gusanos en el útero de la",
     "muerte."
    ],
    "width": 40,
    "fadeIn": 0.1255,
    "burnOut": 0.3485,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.3422,
    "to": 0.6166,
    "seconds": 11.5,
    "lines": [
     "Hacen lodo donde me hundo. Es",
     "mi ecosistema."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.6166,
    "to": 0.9284,
    "seconds": 13.1,
    "lines": [
     "Una sombra líquida que se",
     "infiltra en el suelo y no deja",
     "crecer nada."
    ],
    "width": 32,
    "fadeIn": 0.1377,
    "burnOut": 0.3825,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   }
  ],
  "stations": [
   5.0,
   -0.4,
   -5.8,
   -11.2
  ],
  "moves": {
   "sink": 1.0,
   "swarm": 0.8,
   "press": 0.4
  },
  "seconds": 41.9
 },
 {
  "id": "I-5",
  "canto": "Canto I",
  "mark": "*****",
  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.2552,
    "seconds": 14.0,
    "lines": [
     "Y cuando mi garganta vibra en el vacío",
     "como la cuerda de una guitarra",
     "satánica."
    ],
    "width": 40,
    "fadeIn": 0.1287,
    "burnOut": 0.3576,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.2552,
    "to": 0.5254,
    "seconds": 14.8,
    "lines": [
     "Me persiguen palabras que nunca podré",
     "decir. Algo se está perdiendo.",
     "Quedando más lejos."
    ],
    "width": 40,
    "fadeIn": 0.1216,
    "burnOut": 0.3378,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.5254,
    "to": 0.7353,
    "seconds": 11.5,
    "lines": [
     "Y la amnesia me seduce, me",
     "deja somnoliento."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b4",
    "from": 0.7353,
    "to": 0.9452,
    "seconds": 11.5,
    "lines": [
     "Hace que mis ojos se cierren",
     "dentro de mí."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   }
  ],
  "stations": [
   5.0,
   0.35,
   -4.3,
   -8.95,
   -13.6
  ],
  "moves": {
   "erase": 1.0,
   "stretch": 0.6,
   "cold": 0.3
  },
  "seconds": 54.8
 },
 {
  "id": "II-1",
  "canto": "Canto II",
  "mark": "*",
  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.3057,
    "seconds": 11.5,
    "lines": [
     "Fui expulsado de mi cuerpo. De",
     "donde chupo la vida."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.3057,
    "to": 0.6145,
    "seconds": 11.6,
    "lines": [
     "Suicidando al hombre por el",
     "niño. Abandono la verdad."
    ],
    "width": 32,
    "fadeIn": 0.1549,
    "burnOut": 0.4304,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.6145,
    "to": 0.9203,
    "seconds": 11.5,
    "lines": [
     "Me abandono."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   }
  ],
  "stations": [
   5.0,
   -0.4,
   -5.8,
   -11.2
  ],
  "moves": {
   "double": 1.0,
   "erase": 0.6,
   "tilt": 0.3
  },
  "seconds": 37.6
 },
 {
  "id": "II-2",
  "canto": "Canto II",
  "mark": "**",
  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.1655,
    "seconds": 13.7,
    "lines": [
     "Paso los días preso en mi cuarto.",
     "viendo mi carne mezclarse con las",
     "paredes."
    ],
    "width": 40,
    "fadeIn": 0.1313,
    "burnOut": 0.3647,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.1655,
    "to": 0.3043,
    "seconds": 11.5,
    "lines": [
     "Lágrimas escurren de la",
     "pintura descascarada."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.3043,
    "to": 0.4545,
    "seconds": 12.4,
    "lines": [
     "No existe fuera. Solo existe",
     "hambre. En una oscuridad",
     "verdosa."
    ],
    "width": 32,
    "fadeIn": 0.1447,
    "burnOut": 0.402,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b4",
    "from": 0.4545,
    "to": 0.6353,
    "seconds": 15.0,
    "lines": [
     "Y las hienas, cocodrilos y buitres",
     "comen allí. Pero mi sangre ya se secó.",
     "Aun así muerden."
    ],
    "width": 40,
    "fadeIn": 0.1201,
    "burnOut": 0.3337,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b5",
    "from": 0.6353,
    "to": 0.825,
    "seconds": 15.7,
    "lines": [
     "Cortan las fibras para no olvidar.",
     "Clavando los colmillos hasta que",
     "mueran ellos, hasta olvidarse."
    ],
    "width": 40,
    "fadeIn": 0.1146,
    "burnOut": 0.3183,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b6",
    "from": 0.825,
    "to": 0.9638,
    "seconds": 11.5,
    "lines": [
     "El hambre va a vencer."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   }
  ],
  "stations": [
   5.0,
   1.1,
   -2.8,
   -6.7,
   -10.6,
   -14.5,
   -18.4
  ],
  "moves": {
   "press": 1.0,
   "swarm": 0.8,
   "erase": 0.4
  },
