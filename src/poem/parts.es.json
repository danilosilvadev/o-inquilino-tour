  "beats": [
   {
    "id": "b1",
    "from": 0.0,
    "to": 0.1695,
    "seconds": 11.7,
    "lines": [
     "De un tiempo preñado de",
     "placer, nació una yema blanda."
    ],
    "width": 32,
    "fadeIn": 0.1537,
    "burnOut": 0.427,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b2",
    "from": 0.1695,
    "to": 0.3391,
    "seconds": 11.7,
    "lines": [
     "¿Cómo puede el peso de nada",
     "ser tan difícil de cargar?"
    ],
    "width": 32,
    "fadeIn": 0.1537,
    "burnOut": 0.427,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b3",
    "from": 0.3391,
    "to": 0.606,
    "seconds": 18.4,
    "lines": [
     "Y ese peso lentamente se esparció por",
     "todo mi cuerpo, como si me hubiera",
     "acostado mal. Y hasta el silencio,",
     "pareció más callado."
    ],
    "width": 40,
    "fadeIn": 0.0976,
    "burnOut": 0.2712,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b4",
    "from": 0.606,
    "to": 0.79,
    "seconds": 12.7,
    "lines": [
     "Si abriera mi pecho, aún te",
     "vería allí. Pero te vería",
     "resbalando."
    ],
    "width": 32,
    "fadeIn": 0.1416,
    "burnOut": 0.3934,
    "x": -3.45,
    "y": 1.55,
    "anchor": "left"
   },
   {
    "id": "b5",
    "from": 0.79,
    "to": 0.9566,
    "seconds": 11.5,
    "lines": [
     "Ahora mi rostro está frío.",
     "Fuiste."
    ],
    "width": 32,
    "fadeIn": 0.1565,
    "burnOut": 0.4348,
    "x": 0.3,
    "y": 1.55,
    "anchor": "left"
   }
